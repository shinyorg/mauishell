<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:sample="clr-namespace:Sample"
             x:DataType="sample:PickColorViewModel"
             x:Class="Sample.PickColorPage"
             Title="Pick a Colour">

    <VerticalStackLayout Padding="20" Spacing="12">

        <Label Text="This page is a dialog - the caller is awaiting the colour you pick."
               TextColor="{AppThemeBinding Light=Gray, Dark=LightGray}" />

        <Label Text="{Binding Preset, StringFormat='Preset: {0}'}" />

        <!-- A bindable layout, not a CollectionView: the overlay presenter sizes its card to the
             content, and a CollectionView in an unconstrained stack measures to zero height there. -->
        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Colors}" Spacing="8">
            <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                    <Button Text="{Binding .}"
                            Command="{Binding Source={RelativeSource AncestorType={x:Type sample:PickColorViewModel}}, Path=PickCommand}"
                            CommandParameter="{Binding .}" />
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </VerticalStackLayout>

        <Button Text="Nested dialog" Command="{Binding ShowNestedCommand}" />
        <Label Text="{Binding NestedResult, StringFormat='Nested: {0}'}" FontSize="12" />

        <Button Text="Cancel" Command="{Binding CancelCommand}" />
    </VerticalStackLayout>
</ContentPage>
