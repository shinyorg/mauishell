<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:sample="clr-namespace:Sample"
             x:DataType="sample:HomeViewModel"
             x:Class="Sample.HomePage"
             Title="Shiny Shell">

    <CollectionView ItemsSource="{Binding Demos}"
                    IsGrouped="True">

        <CollectionView.GroupHeaderTemplate>
            <DataTemplate x:DataType="sample:DemoGroup">
                <Label Text="{Binding Name}"
                       FontAttributes="Bold"
                       FontSize="16"
                       Padding="15,15,15,5"
                       TextColor="{StaticResource Primary}" />
            </DataTemplate>
        </CollectionView.GroupHeaderTemplate>

        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="sample:DemoItem">
                <!-- A tap gesture rather than CollectionView selection: UI tests (tests/Sample.UITests) invoke it
                     through DevFlow, which cannot select a row. The title doubles as the AutomationId. -->
                <Grid Padding="15,8"
                      ColumnDefinitions="*,Auto"
                      AutomationId="{Binding Title}">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenCommand, Source={RelativeSource AncestorType={x:Type sample:HomeViewModel}}}"
                                              CommandParameter="{Binding .}" />
                    </Grid.GestureRecognizers>
                    <VerticalStackLayout>
                        <Label Text="{Binding Title}" FontSize="15" />
                        <Label Text="{Binding Description}"
                               FontSize="12"
                               TextColor="{AppThemeBinding Light=Gray, Dark=LightGray}" />
                    </VerticalStackLayout>
                    <Label Grid.Column="1" Text="›"
                           FontSize="20"
                           VerticalOptions="Center"
                           TextColor="Gray" />
                </Grid>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>
