<?xml version="1.0" encoding="UTF-8"?>
<shiny:ShinyShell x:Class="Sample.TabbedShell"
                  xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                  xmlns:shiny="clr-namespace:Shiny;assembly=Shiny.Maui.Shell"
                  xmlns:local="clr-namespace:Sample"
                  Title="Shiny Shell (Tabbed)">

    <TabBar>
        <ShellContent Title="Home"
                      ContentTemplate="{DataTemplate local:HomePage}"
                      Route="HomePage" />
        <!-- badge colors are styled on the tab; SetTabBadge only sets the text -->
        <Tab Title="Badges"
             BadgeColor="Purple"
             BadgeTextColor="White">
            <ShellContent ContentTemplate="{DataTemplate local:BadgeDemoPage}"
                          Route="BadgeDemoPage" />
        </Tab>
    </TabBar>
</shiny:ShinyShell>
