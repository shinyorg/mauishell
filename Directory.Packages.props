<Project>
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    </PropertyGroup>
    <ItemGroup>
        <PackageVersion Include="Microsoft.Extensions.AI" Version="10.9.0" />
        <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="10.9.0" />
        <PackageVersion Include="Nerdbank.GitVersioning" Version="3.10.94" />
        <PackageVersion Include="Microsoft.Maui.Controls" Version="10.0.100" />
        <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
        <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
        <PackageVersion Include="Shiny.Maui.Controls" Version="1.6.0" />
        <PackageVersion Include="UXDivers.Popups.Maui" Version="0.9.4" />
        <PackageVersion Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
    </ItemGroup>
    <ItemGroup>
        <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
        <PackageVersion Include="MartinCostello.Logging.XUnit" Version="0.7.0" />
        <PackageVersion Include="Shouldly" Version="4.3.0" />
        <PackageVersion Include="Verify.SourceGenerators" Version="2.5.0" />
        <PackageVersion Include="Verify.Xunit" Version="31.12.5" />
        <PackageVersion Include="xunit" Version="2.9.3" />
        <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
        <PackageVersion Include="xunit.v3" Version="3.2.2" />
    </ItemGroup>
    <ItemGroup>
        <!-- UI tests (tests/Sample.UITests): the in-app agent the Sample references in Debug. Keep the
             `maui devflow` CLI on the same version (dotnet tool update -g Microsoft.Maui.Cli). -->
        <PackageVersion Include="Microsoft.Maui.DevFlow.Agent" Version="0.1.0-preview.13.26526.5" />
    </ItemGroup>
</Project>